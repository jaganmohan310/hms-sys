<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>com.pulsesquare.hms</groupId>
    <artifactId>pulsesquare-hms-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>PulseSquare Enterprise HMS - Parent</name>
    <description>Enterprise Healthcare Management System - Multi-Module Architecture (OAS, WS, Service, Repo, DB-Dist)</description>

    <modules>
        <module>hms-common</module>
        <module>hms-model</module>
        <module>hms-config</module>
        <module>hms-db-dist</module>
        <module>hms-jooq</module>
        <module>hms-oas</module>
        <module>hms-repo</module>
        <module>hms-service</module>
        <module>hms-ws</module>
        <module>hms-ft</module>
    </modules>

    <properties>
        <java.version>11</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <db2.jcc.version>11.5.8.0</db2.jcc.version>
        <angularjs.version>1.8.2</angularjs.version>
        <springdoc.version>1.6.15</springdoc.version>
        <jjwt.version>0.11.5</jjwt.version>
        <swagger.annotations.version>2.2.8</swagger.annotations.version>
        <openapi-generator.version>7.5.0</openapi-generator.version>
        <jackson-nullable.version>0.2.6</jackson-nullable.version>
        <pulsesquare.version>1.0.0</pulsesquare.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal Enterprise Modules -->
            <dependency>
                <groupId>com.pulsesquare.hms</groupId>
                <artifactId>hms-common</artifactId>
                <version>${pulsesquare.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pulsesquare.hms</groupId>
                <artifactId>hms-model</artifactId>
                <version>${pulsesquare.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pulsesquare.hms</groupId>
                <artifactId>hms-config</artifactId>
                <version>${pulsesquare.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pulsesquare.hms</groupId>
                <artifactId>hms-db-dist</artifactId>
                <version>${pulsesquare.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pulsesquare.hms</groupId>
                <artifactId>hms-jooq</artifactId>
                <version>${pulsesquare.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pulsesquare.hms</groupId>
                <artifactId>hms-oas</artifactId>
                <version>${pulsesquare.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pulsesquare.hms</groupId>
                <artifactId>hms-repo</artifactId>
                <version>${pulsesquare.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pulsesquare.hms</groupId>
                <artifactId>hms-service</artifactId>
                <version>${pulsesquare.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pulsesquare.hms</groupId>
                <artifactId>hms-ws</artifactId>
                <version>${pulsesquare.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pulsesquare.hms</groupId>
                <artifactId>hms-ft</artifactId>
                <version>${pulsesquare.version}</version>
            </dependency>

            <!-- Spring Boot Starter jOOQ (Type-safe SQL replacing Hibernate) -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-jooq</artifactId>
                <version>2.7.18</version>
            </dependency>

            <!-- SpringDoc OpenAPI (OAS 3.0 / Swagger UI) -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Swagger Annotations -->
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations</artifactId>
                <version>${swagger.annotations.version}</version>
            </dependency>

            <!-- JJWT (JSON Web Token Security) -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- IBM Db2 Official JDBC JCC Driver -->
            <dependency>
                <groupId>com.ibm.db2</groupId>
                <artifactId>jcc</artifactId>
                <version>${db2.jcc.version}</version>
            </dependency>

            <!-- Frontend WebJars: Official AngularJS -->
            <dependency>
                <groupId>org.webjars</groupId>
                <artifactId>angularjs</artifactId>
                <version>${angularjs.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jooq</groupId>
                    <artifactId>jooq-codegen-maven</artifactId>
                    <version>3.14.16</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <release>11</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
