# IBM Db2 Database Credentials
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=hms
DB2_USERNAME=db2inst1
DB2_PASSWORD=app

# JWT Security Signing Key (at least 256-bit string in production)
JWT_SECRET=PulseSquareEnterpriseHMSSecretKey2026SecureKeyWithAtLeast256BitsLength!
JWT_EXPIRATION_MS=86400000
